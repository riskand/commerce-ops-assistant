ANTHROPIC_API_KEY=sk-ant-...
# app/config.py builds a Settings object that loads this file and ignores
# keys it doesn't declare, so DATABASE_URL is safe to keep in this same
# file too — app/db.py reads it from that Settings object, not from the
# environment directly.
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost/docsearch

# The tenant the MCP server speaks for, fixed once at startup and
# never taken as a tool argument (see mcp_server/README.md). app/config.py's
# default mcp_servers entry forwards this same value to the server it
# spawns, so setting it here — or exporting it in the parent process's own
# environment — scopes every /chat request without editing any code.
MCP_TENANT_ID=11111111-1111-4111-8111-111111111111

# If port 5432 is already taken on your machine, add a
# docker-compose.override.yml publishing the db container's 5432 on a
# free host port instead (e.g. 55432 — see examples/README.md), then
# point DATABASE_URL above at that port.
